# GeoRoad Inspector — Environment Configuration
# Copy to .env and fill in values

# Database (SQLite for dev, PostgreSQL for prod)
DATABASE_URL=sqlite+aiosqlite:///./georoad.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/georoad

# File storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=.jpg,.jpeg,.png

# YOLO Model
MODEL_WEIGHTS_PATH=./models/road_damage_best.pt
DEFAULT_CONFIDENCE_THRESHOLD=0.25
DEFAULT_IOU_THRESHOLD=0.45

# ArcGIS Online (optional — leave blank to disable)
ARCGIS_PORTAL_URL=
ARCGIS_CLIENT_ID=
ARCGIS_CLIENT_SECRET=
ARCGIS_FEATURE_LAYER_URL=
ARCGIS_WEB_MAP_URL=

# App
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
